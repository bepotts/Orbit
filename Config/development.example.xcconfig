// Supabase Credentials
// Use /$()/ to prevent xcconfig from treating // as a comment.
SUPABASE_PROJECT_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR_KEY
